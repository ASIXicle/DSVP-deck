--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -61,6 +61,8 @@
     Uint8 MSFT_layered_driver;
     // Only required for decoding HDR ASTC textures
     Uint8 EXT_texture_compression_astc_hdr;
+    // DSVP local patch: HDR10 static metadata forwarding (optional)
+    Uint8 EXT_hdr_metadata;
 } VulkanExtensions;
 
 // Defines
@@ -4683,6 +4685,45 @@
         CHECK_VULKAN_ERROR_AND_RETURN(vulkanResult, vkCreateSwapchainKHR, false);
     }
 
+    // DSVP local patch: forward HDR10 static metadata (ST 2086 + CLL)
+    // to the swapchain via VK_EXT_hdr_metadata. The application stores
+    // the values as float properties on the SDL window; on Wayland,
+    // Mesa's WSI translates the call into a color-management
+    // parametric image description for the compositor. Inert unless
+    // the app set the properties, the colorspace is HDR10, and the
+    // device extension is present.
+    if (renderer->supports.EXT_hdr_metadata &&
+        windowData->colorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT) {
+        SDL_PropertiesID hdrProps = SDL_GetWindowProperties(windowData->window);
+        float hdrMaxLum = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.max_luminance", 0.0f);
+        if (hdrMaxLum > 0.0f) {
+            PFN_vkSetHdrMetadataEXT pfnSetHdrMetadata =
+                (PFN_vkSetHdrMetadataEXT)renderer->vkGetDeviceProcAddr(
+                    renderer->logicalDevice, "vkSetHdrMetadataEXT");
+            if (pfnSetHdrMetadata) {
+                VkHdrMetadataEXT hdrMeta;
+                SDL_zero(hdrMeta);
+                hdrMeta.sType = VK_STRUCTURE_TYPE_HDR_METADATA_EXT;
+                hdrMeta.displayPrimaryRed.x = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.red_x", 0.0f);
+                hdrMeta.displayPrimaryRed.y = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.red_y", 0.0f);
+                hdrMeta.displayPrimaryGreen.x = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.green_x", 0.0f);
+                hdrMeta.displayPrimaryGreen.y = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.green_y", 0.0f);
+                hdrMeta.displayPrimaryBlue.x = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.blue_x", 0.0f);
+                hdrMeta.displayPrimaryBlue.y = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.blue_y", 0.0f);
+                hdrMeta.whitePoint.x = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.white_x", 0.0f);
+                hdrMeta.whitePoint.y = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.white_y", 0.0f);
+                hdrMeta.maxLuminance = hdrMaxLum;
+                hdrMeta.minLuminance = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.min_luminance", 0.0f);
+                hdrMeta.maxContentLightLevel = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.max_cll", 0.0f);
+                hdrMeta.maxFrameAverageLightLevel = SDL_GetFloatProperty(hdrProps, "dsvp.hdr.max_fall", 0.0f);
+                pfnSetHdrMetadata(renderer->logicalDevice, 1, &windowData->swapchain, &hdrMeta);
+                SDL_LogInfo(SDL_LOG_CATEGORY_GPU,
+                            "HDR metadata forwarded to swapchain (maxLum=%.0f maxCLL=%.0f maxFALL=%.0f)",
+                            hdrMaxLum, hdrMeta.maxContentLightLevel, hdrMeta.maxFrameAverageLightLevel);
+            }
+        }
+    }
+
     vulkanResult = renderer->vkGetSwapchainImagesKHR(
         renderer->logicalDevice,
         windowData->swapchain,
@@ -11048,7 +11089,7 @@
         supports->ext = 1;                   \
     }
         CHECK(KHR_swapchain)
-        else CHECK(KHR_maintenance1) else CHECK(KHR_driver_properties) else CHECK(KHR_portability_subset) else CHECK(MSFT_layered_driver) else CHECK(EXT_texture_compression_astc_hdr)
+        else CHECK(KHR_maintenance1) else CHECK(KHR_driver_properties) else CHECK(KHR_portability_subset) else CHECK(MSFT_layered_driver) else CHECK(EXT_texture_compression_astc_hdr) else CHECK(EXT_hdr_metadata)
 #undef CHECK
     }
 
@@ -11064,7 +11105,8 @@
         supports->KHR_driver_properties +
         supports->KHR_portability_subset +
         supports->MSFT_layered_driver +
-        supports->EXT_texture_compression_astc_hdr);
+        supports->EXT_texture_compression_astc_hdr +
+        supports->EXT_hdr_metadata);
 }
 
